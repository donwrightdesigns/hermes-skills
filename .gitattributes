# Normalise line endings — these files are served/executed on Linux hosts,
# and stray CRLF in PHP or shell scripts causes real breakage.
* text=auto eol=lf

*.php   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# images stay binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.webp  binary